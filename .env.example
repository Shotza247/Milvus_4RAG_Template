# ==============================================================================
# Milvus & RAG Pipeline Configuration
# ==============================================================================

# --- Application Settings ---
APP_NAME=milvus-rag-api
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# --- Milvus Connection Settings ---
# In Docker/Podman network use host "milvus-standalone", for local dev use "localhost"
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=False
MILVUS_DEFAULT_COLLECTION=rag_documents

# --- MinIO (Milvus Object Storage) Settings ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=milvus-bucket

# --- etcd (Milvus Meta Storage) Settings ---
ETCD_ENDPOINTS=etcd:2379

# --- Embedding Model Settings ---
# Provider options: "sentence-transformers", "fastembed", "openai", "dummy"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Reranking Model Settings ---
# Provider options: "cross-encoder", "flashrank", "cohere", "dummy"
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_TOP_K_CANDIDATES=20
RERANKER_DEFAULT_TOP_N=5
RERANKER_SCORE_THRESHOLD=0.35

# --- Document Processing Defaults ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_STRATEGY=recursive

# --- Evaluation Settings ---
EVAL_DEFAULT_K=5
EVAL_SIMILARITY_METRIC=cosine
OPENAI_API_KEY=
